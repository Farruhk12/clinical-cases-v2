# 1) DATABASE_URL — Neon → Dashboard → Connection string (pooled).
# 2) AUTH_SECRET — случайная длинная строка (без этого сессии ломаются)
# 3) supabase/full_setup.sql — накатить на Neon (npm run db:setup или SQL Editor)

DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
AUTH_SECRET=""

# Порт API. npm run dev сам подберёт свободный, если PORT занят, и синхронизирует прокси Vite (VITE_DEV_API_PORT).
PORT=3001

# Vercel: в Project → Settings → Environment Variables добавьте те же DATABASE_URL и AUTH_SECRET.
# Проверка после деплоя: https://ваш-проект.vercel.app/api/health → {"ok":true,"db":true}

DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-flash"

# Цены DeepSeek за 1M токенов (см. api-docs.deepseek.com/quick_start/pricing) —
# используются для раздела «Настройки → Расходы на ИИ». Меняйте при обновлении прайса.
DEEPSEEK_PRICE_INPUT_PER_1M=0.15
DEEPSEEK_PRICE_OUTPUT_PER_1M=0.6

# Во сколько раз показывать/выставлять расходы на ИИ больше фактических (монетизация).
AI_COST_MARKUP_MULTIPLIER=10
